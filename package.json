{
  "name": "mercy-quest",
  "productName": "Mercy Quest",
  "version": "1.0.0",
  "description": "Mercy Quest desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --mac"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "electron-updater": "^6.0.0"
  },
  "build": {
    "appId": "com.mannix.mercyquest",
    "productName": "Mercy Quest",
    "publish": [
      {
        "provider": "github",
        "owner": "PythonPotato123",
        "repo": "MercyQuest"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}